# VaultNote configuration. Copy to `.env` for local development.
# In production every secret below MUST be set explicitly (the app refuses to
# start otherwise). In development/test they are auto-derived if unset.

# Environment: development | test | production
VAULTNOTE_ENVIRONMENT=development

# Async SQLAlchemy database URL (SQLite for the demo; Postgres for production).
VAULTNOTE_DATABASE_URL=sqlite+aiosqlite:///./vaultnote.db

# --- Secrets (REQUIRED in production) --------------------------------------
# JWT signing key.
VAULTNOTE_JWT_SECRET=change-me-in-production
# Server-side password pepper (HMAC key applied before Argon2id).
VAULTNOTE_PASSWORD_PEPPER=change-me-in-production
# Root key-encryption key (KEK): base64-urlsafe of EXACTLY 32 bytes (AES-256).
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
VAULTNOTE_MASTER_KEK=
# Salt for analytics pseudonymization / audit actor hashing.
VAULTNOTE_ANALYTICS_PSEUDONYM_SALT=change-me-in-production

# --- Optional --------------------------------------------------------------
# Redis URL for the distributed rate limiter (falls back to in-memory if unset).
# VAULTNOTE_REDIS_URL=redis://localhost:6379/0
VAULTNOTE_STORAGE_DIR=./var/storage
VAULTNOTE_MAX_UPLOAD_BYTES=26214400
VAULTNOTE_DEFAULT_DP_EPSILON=1.0
